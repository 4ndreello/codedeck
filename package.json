{
  "name": "codedeck",
  "version": "0.1.2",
  "description": "CodeDeck, a local runtime for coding agents with session management, process supervision, event normalization, and git isolation",
  "type": "module",
  "bin": {
    "codedeck": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "doctor": "node dist/cli/index.js doctor",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": ["agent", "coding-agent", "runtime", "claude", "codex", "opencode", "omp"],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/4ndreello/run-agent.git"
  },
  "homepage": "https://github.com/4ndreello/run-agent#readme",
  "bugs": {
    "url": "https://github.com/4ndreello/run-agent/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
