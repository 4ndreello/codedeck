{
  "description": "Codedeck agents pane: draws this session's dispatched workers as ASCII in a pane docked on the right (requires Claude Code with function hooks enabled).",
  "modules": ["./register.tsx"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-id.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-name.sh\""
          }
        ]
      }
    ]
  }
}
