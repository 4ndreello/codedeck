{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "blood": "#E11D48",
    "shimmer": "#C026D3",
    "ember": "#FB923C",
    "amber": "#FBBF24",
    "remember": "#FACC15",
    "green": "#4ADE80",
    "red": "#FF4D6D",
    "text": "#F7EDEE",
    "muted": "#A38B8F",
    "ink": "#140406",
    "panel": "#1F0A0E",
    "element": "#2A0710",
    "rose": "#FDA4AF",
    "pink": "#F472B6",
    "blue": "#60A5FA",
    "cyan": "#22D3EE",
    "mint": "#34D399",
    "purple": "#C084FC",
    "deepGreen": "#14532D",
    "deepRed": "#7F1D1D"
  },
  "theme": {
    "primary": { "dark": "blood", "light": "blood" },
    "secondary": { "dark": "rose", "light": "blood" },
    "accent": { "dark": "shimmer", "light": "shimmer" },
    "error": { "dark": "red", "light": "red" },
    "warning": { "dark": "amber", "light": "amber" },
    "success": { "dark": "green", "light": "green" },
    "info": { "dark": "blue", "light": "blue" },
    "text": { "dark": "text", "light": "ink" },
    "textMuted": { "dark": "muted", "light": "muted" },
    "background": { "dark": "ink", "light": "text" },
    "backgroundPanel": { "dark": "panel", "light": "rose" },
    "backgroundElement": { "dark": "element", "light": "rose" },
    "border": { "dark": "blood", "light": "blood" },
    "borderActive": { "dark": "ember", "light": "ember" },
    "borderSubtle": { "dark": "muted", "light": "muted" },
    "diffAdded": { "dark": "green", "light": "deepGreen" },
    "diffRemoved": { "dark": "red", "light": "deepRed" },
    "diffContext": { "dark": "muted", "light": "muted" },
    "diffHunkHeader": { "dark": "cyan", "light": "blue" },
    "diffHighlightAdded": { "dark": "green", "light": "deepGreen" },
    "diffHighlightRemoved": { "dark": "red", "light": "deepRed" },
    "diffAddedBg": { "dark": "deepGreen", "light": "green" },
    "diffRemovedBg": { "dark": "deepRed", "light": "red" },
    "diffContextBg": { "dark": "ink", "light": "text" },
    "diffLineNumber": { "dark": "muted", "light": "muted" },
    "diffAddedLineNumberBg": { "dark": "deepGreen", "light": "green" },
    "diffRemovedLineNumberBg": { "dark": "deepRed", "light": "red" },
    "markdownText": { "dark": "text", "light": "ink" },
    "markdownHeading": { "dark": "blood", "light": "blood" },
    "markdownLink": { "dark": "cyan", "light": "blue" },
    "markdownLinkText": { "dark": "cyan", "light": "blue" },
    "markdownCode": { "dark": "ember", "light": "ember" },
    "markdownBlockQuote": { "dark": "muted", "light": "muted" },
    "markdownEmph": { "dark": "rose", "light": "blood" },
    "markdownStrong": { "dark": "text", "light": "ink" },
    "markdownHorizontalRule": { "dark": "blood", "light": "blood" },
    "markdownListItem": { "dark": "ember", "light": "ember" },
    "markdownCodeBlock": { "dark": "element", "light": "rose" },
    "syntaxComment": { "dark": "muted", "light": "muted" },
    "syntaxKeyword": { "dark": "blood", "light": "blood" },
    "syntaxFunction": { "dark": "blue", "light": "blue" },
    "syntaxVariable": { "dark": "cyan", "light": "blue" },
    "syntaxString": { "dark": "green", "light": "deepGreen" },
    "syntaxNumber": { "dark": "ember", "light": "ember" },
    "syntaxType": { "dark": "purple", "light": "shimmer" },
    "syntaxOperator": { "dark": "pink", "light": "blood" },
    "syntaxPunctuation": { "dark": "muted", "light": "muted" }
